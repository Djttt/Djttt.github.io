---
import Base from '../layouts/Base.astro';
import { skills } from '../data/skills';
import { awards } from '../data/education';
import { profile } from '../data/profile';
import { route } from '../utils/path';
---

<Base title="关于我 · 邓君" description="邓君：教育背景、专业技能、论文荣誉与联系方式。">
  <div class="page article-head">
    <p class="article-kicker">about — the person behind the systems</p>
    <h1 class="article-title">关于我</h1>
    <p class="article-meta">计算机技术硕士 · 成都 · 让每一次优化都有可复现的数字</p>
  </div>

  <section class="sec">
    <div class="page sec-grid">
      <div class="sec-mark">
        <span class="sec-no">1</span>
        <span class="sec-key">skills</span>
      </div>
      <div class="sec-body">
        <h2>专业技能</h2>
        {
          skills.map((s) => (
            <div class="skill">
              <h3>
                {s.name}
                <span class="skill-key">{s.key}</span>
              </h3>
              <p>{s.desc}</p>
              <div class="tags">
                {s.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sec rule-top">
    <div class="page sec-grid">
      <div class="sec-mark">
        <span class="sec-no">2</span>
        <span class="sec-key">papers &amp; awards</span>
      </div>
      <div class="sec-body">
        <h2>论文与荣誉</h2>
        <div class="ref">
          <span class="ref-no">[P]</span>
          <div>
            <h3 class="ref-title">光学学报（中科院 2 区）· 论文 1 篇</h3>
            <p class="ref-meta">
              <span class="org">西南石油大学</span> · <span class="period">2024 – 2027</span> · 第一单位在读发表
            </p>
          </div>
        </div>
        <ul class="tl-points">
          {
            awards.map((a) => (
              <li>
                {a.name}
                {a.year && <span class="award-year">（{a.year}）</span>}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="sec rule-top">
    <div class="page sec-grid">
      <div class="sec-mark">
        <span class="sec-no">3</span>
        <span class="sec-key">contact</span>
      </div>
      <div class="sec-body">
        <h2>联系方式</h2>
        <div class="panel">
          <table class="bench">
            <tbody>
              <tr>
                <td class="b-label">邮箱</td>
                <td class="b-value">
                  <a href={`mailto:${profile.email}`}>{profile.email}</a>
                </td>
              </tr>
              <tr>
                <td class="b-label">电话</td>
                <td class="b-value">{profile.phone}</td>
              </tr>
              <tr>
                <td class="b-label">所在地</td>
                <td class="b-value">{profile.location}</td>
              </tr>
              <tr>
                <td class="b-label">GitHub</td>
                <td class="b-value">
                  <a href={profile.github} target="_blank" rel="noopener">
                    {profile.github.replace('https://', '')}
                  </a>
                </td>
              </tr>
              <tr>
                <td class="b-label">简历</td>
                <td class="b-value">
                  <a href={route('/resume.pdf')} download>
                    下载 PDF
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .skill h3 {
    font-size: 1.08rem;
  }
  .award-year {
    color: var(--ink-3);
    font-family: var(--mono);
    font-size: 0.78rem;
  }
</style>
