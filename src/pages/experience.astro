---
import Base from '../layouts/Base.astro';
import { education } from '../data/education';
import { internships } from '../data/experience';
import { route } from '../utils/path';
---

<Base title="实习经历 · 邓君" description="邓君在博世（BOSCH）的实习成果：非标设备智能知识库 RAG 与端侧 AI 推理服务优化。">
  <div class="page article-head">
    <p class="article-kicker">experience — internship record</p>
    <h1 class="article-title">实习经历</h1>
    <p class="article-meta">企业级 AI 系统的真实战场：检索质量、推理吞吐与工程化交付</p>
  </div>

  <section class="sec">
    <div class="page sec-grid">
      <div class="sec-mark">
        <span class="sec-no">1</span>
        <span class="sec-key">bosch</span>
      </div>
      <div class="sec-body">
        {
          internships.map((job) => (
            <article class="tl-item">
              <div class="tl-head">
                <span class="tl-title">{job.company}（{job.companyEn}）</span>
                <span class="tl-when">{job.period}</span>
              </div>
              <p class="tl-sub">实习部门 {job.dept}</p>

              {job.programs.map((p, i) => (
                <div class="program">
                  <h2 class="program-title">
                    <span class="program-no">{i + 1}.</span> {p.title}
                  </h2>
                  <p class="program-intro">{p.intro}</p>

                  {p.metrics.length > 0 && (
                    <table class="bench">
                      <tbody>
                        {p.metrics.map((m) => (
                          <tr>
                            <td class="b-label">{m.label}</td>
                            <td class="b-value">{m.value}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  )}

                  <ul class="tl-points">
                    {p.points.map((pt) => (
                      <li>{pt}</li>
                    ))}
                  </ul>

                  <div class="tags">
                    {p.stack.map((s) => (
                      <span class="tag">{s}</span>
                    ))}
                  </div>
                </div>
              ))}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sec rule-top">
    <div class="page sec-grid">
      <div class="sec-mark">
        <span class="sec-no">2</span>
        <span class="sec-key">education</span>
      </div>
      <div class="sec-body">
        <h2>教育背景</h2>
        <div class="timeline">
          {
            education.map((e) => (
              <article class="tl-item">
                <div class="tl-head">
                  <span class="tl-title">{e.school}</span>
                  <span class="badge">{e.badge}</span>
                  <span class="tl-when">{e.period}</span>
                </div>
                <p class="tl-sub">{e.degree} · {e.school2}</p>
                <ul class="tl-points">
                  {e.points.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="sec rule-top">
    <div class="page sec-grid">
      <div class="sec-mark">
        <span class="sec-no">3</span>
        <span class="sec-key">lab projects</span>
      </div>
      <div class="sec-body">
        <h2>科研与训练项目</h2>
        <p class="section-lead">
          与院所、实验室合作的完整技术报告见
          <a href={route('/projects/')}>项目成果</a>：自适应光学实时波前处理（中科院成都光电所）、GPU
          算力资源管理与容器化训练平台（西南石油大学计科院）。
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .program {
    margin-top: 2.2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--rule-soft);
  }
  .program-title {
    font-size: 1.25rem;
    margin-bottom: 0.6rem;
  }
  .program-no {
    color: var(--accent);
    font-family: var(--serif);
  }
  .program-intro {
    color: var(--ink-2);
    font-size: 0.95rem;
    margin-bottom: 1.2rem;
  }
  .program .bench {
    margin-bottom: 1.2rem;
  }
  .badge {
    font-family: var(--mono);
    font-size: 0.68rem;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 3px;
    padding: 0.03rem 0.35rem;
    white-space: nowrap;
  }
</style>
