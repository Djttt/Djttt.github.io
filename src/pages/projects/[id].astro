---
import Base from '../../layouts/Base.astro';
import { route } from '../../utils/path';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({
    params: { id: p.id },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const all = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
const idx = all.findIndex((p) => p.id === project.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;
const links = project.data.links ?? {};
---

<Base title={`${project.data.title} · 项目成果 · 邓君`} description={project.data.summary}>
  <div class="page article-head">
    <p class="article-kicker">
      project [{String(project.data.order).padStart(2, '0')}]
    </p>
    <h1 class="article-title">{project.data.title}</h1>
    <p class="article-meta">
      {project.data.org} · {project.data.period} · {project.data.role}
    </p>
    <div class="tags">
      {
        project.data.tags.map((t) => (
          <span class="tag">{t}</span>
        ))
      }
    </div>
    {(links.repo || links.demo || links.paper) && (
      <div class="article-links">
        {links.repo && (
          <a class="btn btn--plain" href={links.repo} target="_blank" rel="noopener">
            源码仓库
          </a>
        )}
        {links.demo && (
          <a class="btn btn--plain" href={links.demo} target="_blank" rel="noopener">
            在线演示
          </a>
        )}
        {links.paper && (
          <a class="btn btn--plain" href={links.paper} target="_blank" rel="noopener">
            相关论文
          </a>
        )}
      </div>
    )}
  </div>

  <div class="page">
    {
      project.data.metrics.length > 0 && (
        <aside class="panel metrics-panel">
          <h3>核心指标</h3>
          <table class="bench">
            <tbody>
              {project.data.metrics.map((m) => (
                <tr>
                  <td class="b-label">{m.label}</td>
                  <td class="b-value">{m.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </aside>
      )
    }

    <article class="prose">
      <Content />
    </article>

    <nav class="proj-nav" aria-label="项目导航">
      {
        prev ? (
          <a href={route(`/projects/${prev.id}/`)} class="nav-prev">
            ← {prev.data.title}
          </a>
        ) : (
          <span></span>
        )
      }
      {
        next ? (
          <a href={route(`/projects/${next.id}/`)} class="nav-next">
            {next.data.title} →
          </a>
        ) : (
          <span></span>
        )
      }
    </nav>
  </div>
</Base>

<style>
  .article-links {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-top: 1.2rem;
  }
  .metrics-panel {
    margin: 2.4rem 0 0.5rem;
  }
  .metrics-panel h3 {
    margin-bottom: 0.6rem;
  }
  .proj-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule-soft);
    font-family: var(--sans);
    font-size: 0.88rem;
  }
  .nav-next {
    text-align: right;
  }
</style>
