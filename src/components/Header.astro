---
import { route, isActive } from '../utils/path';
const pathname = Astro.url.pathname;
const nav = [
  { label: '首页', path: '/' },
  { label: '实习经历', path: '/experience' },
  { label: '项目成果', path: '/projects' },
  { label: '关于我', path: '/about' },
];
---

<header class="masthead">
  <div class="masthead-inner">
    <a class="brand" href={route('/')} aria-label="邓君 · 返回首页">
      <span class="monogram" aria-hidden="true">邓</span>
      <span class="brand-text">
        <span class="brand-name">邓君 · Deng Jun</span>
        <span class="brand-sub">西南石油大学 · 计算机技术硕士</span>
      </span>
    </a>
    <nav class="nav" aria-label="主导航">
      {
        nav.map((item) => (
          <a
            href={route(item.path)}
            aria-current={isActive(pathname, item.path) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <button class="theme-toggle" id="theme-toggle" aria-label="切换深浅色主题" title="切换深浅色主题">
        ◐
      </button>
    </nav>
  </div>
</header>

<style>
  .brand-text {
    display: flex;
    flex-direction: column;
  }
</style>

<script>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      const root = document.documentElement;
      const isDark = root.dataset.theme === 'dark';
      if (isDark) delete root.dataset.theme;
      else root.dataset.theme = 'dark';
      try {
        localStorage.setItem('theme', isDark ? 'light' : 'dark');
      } catch (e) {
        /* ignore */
      }
    });
  })();
</script>
