---
import { route } from '../utils/path';
const home = route('/');
const nav = [
  { label: '动态', hash: '#news' },
  { label: '项目', hash: '#projects' },
  { label: '实习', hash: '#exp' },
  { label: '教育', hash: '#edu' },
  { label: '技能', hash: '#skills' },
  { label: '荣誉', hash: '#awards' },
];
---

<header class="masthead">
  <div class="masthead-inner">
    <a class="brand" href={`${home}#top`} aria-label="邓君 · 返回首页">邓君 <span class="brand-en">Deng Jun</span></a>
    <nav class="nav" aria-label="主导航">
      {
        nav.map((item) => (
          <a href={`${home}${item.hash}`}>{item.label}</a>
        ))
      }
      <button class="theme-toggle" id="theme-toggle" aria-label="切换深浅色主题" title="切换深浅色主题">◐</button>
    </nav>
  </div>
</header>

<style>
  .brand-en {
    color: var(--muted-ink);
    font-weight: 500;
    font-size: 0.86em;
    margin-left: 2px;
  }
</style>

<script>
  (function () {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function () {
      const root = document.documentElement;
      const isDark = root.dataset.theme === 'dark';
      if (isDark) delete root.dataset.theme;
      else root.dataset.theme = 'dark';
      try {
        localStorage.setItem('theme', isDark ? 'light' : 'dark');
      } catch (e) {
        /* ignore */
      }
    });
  })();
</script>
