---
import { profile } from '../data/profile';
import { route } from '../utils/path';
const home = route('/');
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="foot-inner">
    <span>
      © {year} {profile.name}（{profile.nameEn}）· 更新于 {profile.updated} · 基于 Astro 部署于 GitHub Pages
    </span>
    <span class="foot-links">
      <a href={`mailto:${profile.email}`} rel="noopener">邮件</a>
      <a href={profile.github} rel="noopener" target="_blank">GitHub</a>
      <a href={route('/resume.pdf')} download>简历 PDF</a>
      <a href={`${home}#top`}>回到顶部</a>
    </span>
  </div>
</footer>
